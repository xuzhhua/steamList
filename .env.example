# Copy to .env and adjust. docker compose reads this file automatically.

# Host port exposed by the container (default http://<host>:8080)
STEAMLIST_PORT=8080

# Scheduler timezone (cron-like poll times below are computed in this zone)
TZ=Asia/Shanghai
STEAMLIST_TIMEZONE=Asia/Shanghai

# Store region / language used when querying Steam prices
STEAMLIST_DEFAULT_CC=cn
STEAMLIST_DEFAULT_LANG=schinese

# Enable/disable the background poller inside the container
STEAMLIST_ENABLE_SCHEDULER=true

# Optional outbound HTTP(S) proxy for the container.
# When the host uses Watt Toolkit (Steam++) or a local proxy, the proxy listens on
# the host loopback; containers cannot reach 127.0.0.1 of the host, so use:
#   STEAMLIST_PROXY_URL=http://host.docker.internal:10808
STEAMLIST_PROXY_URL=
